# Copia este archivo como ".env" antes de iniciar el servidor.
# Nunca subas tu archivo ".env" real a un repositorio público.

PORT=3000

# En tu propio servidor de producción (Render, Railway, etc.) pon:
#   NODE_ENV=production
# El servidor se niega a arrancar en producción si JWT_SECRET sigue
# siendo el valor de ejemplo, para que nunca quede inseguro por olvido.
NODE_ENV=development

# Clave secreta usada para firmar los tokens de sesión (JWT).
# Cambia este valor por una cadena larga y aleatoria en producción.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-real-y-larga

# Cuánto dura la sesión antes de que el usuario deba volver a iniciar sesión.
JWT_EXPIRES_IN=8h

# Ruta del archivo de base de datos SQLite (se crea automáticamente).
DB_PATH=./data/hostal.db

# Zona horaria del hostal (para "hoy", cierres de caja y ventanas de reserva).
TZ=America/Lima

# Contraseñas iniciales de los usuarios (solo se usan la PRIMERA vez que se
# crea la base de datos). Si no las defines, se usan admin123 / recep123 y el
# panel pedirá cambiarlas.
# ADMIN_PASSWORD=
# RECEPCION_PASSWORD=

# Si el servidor está detrás de un proxy (Render, Railway, Nginx), cuántos
# saltos de proxy confiar para leer la IP real del cliente. En producción el
# valor por defecto es 1.
# TRUST_PROXY=1

# Orígenes permitidos para CORS (los dos frontales: panel + sitio público).
# Separados por coma. En el deploy de producción pon las URLs reales.
# En desarrollo local no hace falta tocarlo: el default cubre localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Respaldo automático a Google Sheets (opcional). Si dejas esto tal cual
# (o en false), el sistema funciona exactamente igual, solo que sin este
# respaldo extra. Guía paso a paso: GOOGLE_SHEETS_SETUP.md
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_SHEET_ID=
